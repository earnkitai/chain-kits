# Copy to .env (never commit it).
# base (mainnet: campaigns score here; sending needs CONFIRM_MAINNET=1) | base-sepolia
CHAIN=
# The wallet that deploys and sends test check-ins (needs a little gas on CHAIN).
PRIVATE_KEY=
# Optional: your own Builder Code from base.dev -> Settings -> Builder Code (also qualifies you for Base rewards).
BUILDER_CODE=
# The Checkin address npm run deploy printed.
CHECKIN=
